# 真实链上 NFT 铸造配置（Vite 前端）
# 复制为 .env.local 后填入你已部署的合约地址即可启用链上铸造。
# 未配置 VITE_CONTRACT_ADDRESS 时，占卜结尾仍会展示纪念卡片，但链上铸造按钮显示"未配置合约地址"并禁用。

# 目标网络：testnet（默认）或 mainnet
VITE_NETWORK=testnet

# 已部署的 MonadCardNFT 合约地址（见 mingrate/monad-nft-card-demo 的部署脚本输出）
VITE_CONTRACT_ADDRESS=0xYourDeployedContractAddress

# ===== 本地代理 / 语音识别（tts-proxy.cjs 与 mingrate/wanfa 脚本） =====
# 阿里云百炼 API Key 与工作空间 ID，在百炼控制台创建。切勿提交到公开仓库。
ALIYUN_KEY=sk-your-aliyun-bailian-key
ALIYUN_WS_ID=ws-your-workspace-id
